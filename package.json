{
  "name": "opencode-autocompact",
  "version": "0.1.0",
  "type": "module",
  "description": "Automatic context compaction for OpenCode at an absolute token threshold.",
  "author": "Danish Hakim",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "autocompact",
    "compaction",
    "tokens"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src/index.ts",
    "src/engine.ts",
    "src/settings.ts",
    "src/store.ts",
    "src/status.ts",
    "src/rpc.ts",
    "src/gui.tsx",
    "src/gui/state.ts",
    "src/gui/settings-page.tsx",
    "src/gui/pill.tsx",
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:gui": "vite build",
    "check": "npm run typecheck && npm test && npm run build:gui",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "solid-js": "^1.9.20",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerit3787/opencode-autocompact.git"
  },
  "homepage": "https://github.com/Jerit3787/opencode-autocompact#readme",
  "bugs": {
    "url": "https://github.com/Jerit3787/opencode-autocompact/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
