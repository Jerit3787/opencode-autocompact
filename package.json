{
  "name": "opencode-autocompact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automatic context compaction for OpenCode at an absolute token threshold.",
  "author": "Danish Hakim",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "autocompact",
    "compaction",
    "tokens"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:gui": "vite build",
    "check": "npm run typecheck && npm test && npm run build:gui"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "solid-js": "^1.9.20",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.0.5"
  }
}
